# direnv: auto-loads whenever a shell cd's into this repo, and unloads on
# cd out — keeps this project's GCP identity from leaking into terminals
# working on other Google accounts/projects (Adán runs a dual-account setup
# across VS Code windows). Requires `brew install direnv` + the shell hook;
# see README.md's GCP setup section.

# Scopes gcloud CLI commands run in this shell to the `radio-comp` named
# configuration (its own account/project/region) without touching the
# globally active `gcloud config configurations activate` config used
# elsewhere.
export CLOUDSDK_ACTIVE_CONFIG_NAME=radio-comp

# Also load .env (STORAGE_BACKEND, GCP_PROJECT_ID, GOOGLE_APPLICATION_CREDENTIALS, ...)
# into the shell itself, not just into the Python process via python-dotenv.
dotenv_if_exists .env
