# Copy to .env (gitignored) and fill in. See README.md's GCP setup section.

STORAGE_BACKEND=local
# STORAGE_BACKEND=firestore

GCP_PROJECT_ID=project-a6778446-201f-4aa5-a03
GCP_REGION=europe-west2

# Dedicated service account key for this project's Firestore/Storage access —
# keeps the app's GCP identity isolated from whichever personal Google
# account happens to be logged into gcloud/VS Code at the time. Store the
# key file OUTSIDE this repo (e.g. ~/.config/gcloud/radio-comp-app-key.json)
# and point this at it. Leave unset to fall back to ADC (application-default
# login) instead.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/radio-comp-app-key.json
