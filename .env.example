# Copy to .env (gitignored) and fill in. See README.md's GCP setup section.

STORAGE_BACKEND=local
# STORAGE_BACKEND=firestore   # local dev — needs `gcloud auth application-default login`
# STORAGE_BACKEND=gcs         # what Cloud Run Jobs use — Firestore is blocked for service accounts here

GCP_PROJECT_ID=project-a6778446-201f-4aa5-a03
GCP_REGION=europe-west2

# Only used when STORAGE_BACKEND=gcs. Bucket lives in us-central1, not
# europe-west2 — see README's GCP setup section on Storage's Always Free
# tier region restriction.
GCS_BUCKET_NAME=project-a6778446-201f-4aa5-a03-data

# Telegram bot — see README's "Telegram bot" section for how to get these.
# Leave unset to skip notifications entirely (notify/send.py no-ops).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=       # only read by webhook/app.py, not the discovery job

# A real personal Global Player login (email + password) — only used by
# stations/global_win.py's login(), which is standalone/on-demand for
# future entry-submission work and is never called by scheduled discovery
# (global_win.py's own ingest() needs no credentials at all — see
# docs/build-log.md). This is a real personal password, not a bot/service
# credential like everything else in this file — the accepted risk (real
# account suspension if Global's anti-automation detection ever flags it)
# is documented in docs/build-log.md. Leave unset until you're ready to
# actually use login() yourself.
# GLOBAL_PLAYER_EMAIL=
# GLOBAL_PLAYER_PASSWORD=

# entry_execution/llm_mapping.py's one LLM call (generic entry-form field
# mapping — never sees your actual name/DOB/address/phone/email). Gemini,
# not Claude — deliberately, so this isn't tied to a work Anthropic
# account; a free-tier key from a personal Google account works fine
# given how rarely this runs. Read directly by the google-genai SDK, not
# by config.py. Get a key from aistudio.google.com (no billing required),
# then in production this is a Secret Manager secret (gemini-api-key), not
# a real .env value — see docs/build-log.md's entry-execution section.
# GEMINI_API_KEY=

# A dedicated service-account-key setup was tried for this project and
# blocked by an org-level Deny policy neither the project owner nor Claude
# Code can view or edit (see docs/build-log.md, 2026-09-02) — so for now,
# local dev just uses `gcloud auth application-default login` as your own
# account (no impersonation). Leave this unset. It's kept here in case a
# future account/org setup allows a real service account key again.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/radio-comp-app-key.json
